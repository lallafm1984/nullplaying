# Optional non-interactive setup: create ../../.env.supabase.local and fill these values.
# Never commit that file. If omitted, use `npm run supabase:login` and enter the DB password
# securely when `npm run supabase:link` prompts for it.
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token

# Project Settings > Database. This is not the publishable API key.
SUPABASE_DB_PASSWORD=your_database_password
